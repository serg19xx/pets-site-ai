# Copy to .env.production on the OVH host (do not commit secrets).
POSTGRES_USER=pets
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pets

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated emails that can see/reply to all beta feedback tickets
# Must match a registered PETS account
ADMIN_EMAILS=tagsmith.web@gmail.com

FRONTEND_URL=https://pb.websmith-shop.com
ADMIN_URL=https://admin.pb.websmith-shop.com
AUTH_SIGNUP_DELIVERY=password

# Optional fixed invite token (otherwise derived from JWT_SECRET)
# BETA_INVITE_TOKEN=

# Email (Resend) — domain must be Verified; sender on that domain
RESEND_API_KEY=
EMAIL_FROM=PETS Beta <noreply@websmith-shop.com>
