# Backend: copy to .env (do not commit .env).
# Use a single DATABASE_URL so switching Docker Postgres ↔ Supabase is an env change, not a code change.

PORT=8080

# Default when Postgres runs via `docker compose up` WITHOUT a root `.env` (Compose defaults: user pets, password pets_dev_change_me, db pets).
DATABASE_URL=postgresql://pets:pets_dev_change_me@127.0.0.1:5432/pets

# If you use a root `.env` with POSTGRES_PASSWORD=mysecret, use the same password here:
# DATABASE_URL=postgresql://pets:mysecret@127.0.0.1:5432/pets

# --- Same Compose network (API runs as `api` service in docker-compose) ---
# DATABASE_URL=postgresql://pets:pets_dev_change_me@postgres:5432/pets

# --- Supabase (Project Settings → Database → connection string / pooler) ---
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@[host]:6543/postgres

# --- Auth (JWT, email, signup delivery) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# Comma-separated emails that can list/reply to all beta feedback
# ADMIN_EMAILS=tagsmith.web@gmail.com
# Optional fixed beta invite token (otherwise HMAC of JWT_SECRET)
# BETA_INVITE_TOKEN=
# ADMIN_URL=http://localhost:3001
# password = email temporary password + verify link | link = one-time sign-in link
AUTH_SIGNUP_DELIVERY=password

# Uploads — files on disk; DB stores relative paths (avatars/…, pets/gallery/…).
# Default: backend/uploads/ (persists across dev restarts; mount this dir on the server).
# Docker API service sets UPLOADS_DIR=/app/uploads and bind-mounts ./backend/uploads.
# UPLOADS_DIR=./uploads
# UPLOAD_MAX_BYTES=5242880

# --- Email: real delivery (pick ONE) ---
# Option A — Resend (easiest): https://resend.com → API Keys
# Free test without domain: from onboarding@resend.dev, only to your Resend account email.
# After domain Verified (e.g. websmith-shop.com):
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=PETS Beta <noreply@websmith-shop.com>

# Option B — Gmail SMTP (Google Account → Security → App passwords)
# EMAIL_FROM=Your Name <you@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=false

# --- SMS (optional, Twilio) — real SMS only when all three are set ---
# Without Twilio: inquiry SMS is logged in the API terminal (and backup email if email alerts are off).
# https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567

# Option B — Brevo (free SMTP): https://app.brevo.com → SMTP & API
# EMAIL_FROM=PETS <you@yourdomain.com>
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email
# SMTP_PASS=your-brevo-smtp-key
