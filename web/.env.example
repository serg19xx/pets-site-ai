# Dev: run ./scripts/dev.sh then open http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Header logo variant: wide | circle (or use ?brand=wide / ?brand=circle in the URL)
# NUXT_PUBLIC_BRAND_LOGO=wide
# Required when Nuxt runs without a TTY (e.g. ./scripts/dev.sh background)
NUXT_TELEMETRY_DISABLED=1
# Leave empty for same-origin /api (proxied to backend via devProxy or routeRules)
# NUXT_PUBLIC_API_BASE=
# Backend URL for SSR and Nitro API proxy (default http://127.0.0.1:8080)
# NUXT_API_INTERNAL=http://127.0.0.1:8080
